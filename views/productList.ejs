<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Products - E-Shop</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <%- include('partials/navbar') %>

    <div class="container mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>All Products</h2>
            <% if (user) { %>
                <a href="/products/add" class="btn btn-primary">+ Add New Product</a>
            <% } %>
        </div>

        <!-- Filter by Category Section -->
        <div class="card p-3 mb-4 shadow-sm">
            <form action="/products" method="GET" class="row g-3 align-items-center">
                <div class="col-auto">
                    <label for="categoryFilter" class="col-form-label fw-bold">Filter By Category:</label>
                </div>
                <div class="col-auto">
                    <select name="category" id="categoryFilter" class="form-select">
                        <option value="">-- All Categories --</option>
                        <% categories.forEach(cat => { %>
                            <option value="<%= cat._id %>" <%= selectedCategory == cat._id.toString() ? 'selected' : '' %>>
                                <%= cat.name %>
                            </option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-secondary">Apply Filter</button>
                    <% if (selectedCategory) { %>
                        <a href="/products" class="btn btn-outline-dark">Reset</a>
                    <% } %>
                </div>
            </form>
        </div>

        <!-- Product Cards -->
        <div class="row">
            <% if (products.length > 0) { %>
                <% products.forEach(product => { %>
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title text-primary"><%= product.name %></h5>
                                <h6 class="card-subtitle mb-2 text-success fw-bold">$<%= product.price %></h6>
                                <p class="card-text text-muted"><%= product.description %></p>
                                <p class="card-text">
                                    <small class="badge bg-info text-dark">
                                        Category: <%= product.category ? product.category.name : 'Uncategorized' %>
                                    </small>
                                </p>
                            </div>
                            <div class="card-footer bg-transparent d-flex justify-content-between align-items-center">
                                <small class="text-muted">Added by: <%= product.user ? product.user.username : 'Unknown' %></small>
                                <a href="/products/item/<%= product._id %>" class="btn btn-outline-primary btn-sm">View Details</a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-12">
                    <div class="alert alert-info text-center">No products found.</div>
                </div>
            <% } %>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
