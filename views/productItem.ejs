<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.name %> - Details</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <%- include('partials/navbar') %>

    <div class="container mt-4 mb-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow">
                    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">Product Details</h4>
                        <span class="badge bg-primary fs-6">$<%= product.price %></span>
                    </div>
                    <div class="card-body p-4">
                        <h2 class="card-title text-primary"><%= product.name %></h2>
                        <hr>
                        <div class="mb-3">
                            <strong class="text-secondary">Category:</strong>
                            <span class="badge bg-info text-dark fs-6 ms-2">
                                <%= product.category ? product.category.name : 'Uncategorized' %>
                            </span>
                        </div>
                        <div class="mb-3">
                            <strong class="text-secondary">Description:</strong>
                            <p class="mt-2 p-3 bg-light rounded border"><%= product.description || 'No description provided.' %></p>
                        </div>
                        <div class="mb-3">
                            <strong class="text-secondary">Added By:</strong>
                            <span class="text-dark fw-semibold ms-2"><%= product.user ? product.user.username : 'Unknown User' %></span>
                        </div>
                        <div class="mb-3">
                            <strong class="text-secondary">Created At:</strong>
                            <span class="text-muted ms-2"><%= new Date(product.createdAt).toLocaleString() %></span>
                        </div>

                        <hr>
                        <div class="d-flex justify-content-between">
                            <a href="/products" class="btn btn-secondary">← Back to Products</a>
                            
                            <% if (user && (user.id == product.user._id.toString() || user.role == 'admin')) { %>
                                <div>
                                    <a href="/products/edit/<%= product._id %>" class="btn btn-warning">Edit</a>
                                    <a href="/products/delete/<%= product._id %>" class="btn btn-danger" onclick="return confirm('Delete this product?');">Delete</a>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
