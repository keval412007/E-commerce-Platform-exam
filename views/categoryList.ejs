<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categories - E-Shop</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <%- include('partials/navbar') %>

    <div class="container mb-5">
        <h2 class="mb-4">Product Categories</h2>

        <div class="row">
            <!-- Category List Table -->
            <div class="col-md-7">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0">All Categories</h5>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-striped table-hover mb-0">
                            <thead class="table-secondary">
                                <tr>
                                    <th>#</th>
                                    <th>Category Name</th>
                                    <th>Description</th>
                                    <% if (user && user.role === 'admin') { %>
                                        <th>Action</th>
                                    <% } %>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (categories.length > 0) { %>
                                    <% categories.forEach((cat, index) => { %>
                                        <tr>
                                            <td><%= index + 1 %></td>
                                            <td><strong><%= cat.name %></strong></td>
                                            <td><%= cat.description || '-' %></td>
                                            <% if (user && user.role === 'admin') { %>
                                                <td>
                                                    <a href="/categories/delete/<%= cat._id %>" class="btn btn-sm btn-danger" onclick="return confirm('Delete this category?');">Delete</a>
                                                </td>
                                            <% } %>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4" class="text-center p-3 text-muted">No categories added yet.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Add Category Form -->
            <div class="col-md-5">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Add New Category</h5>
                    </div>
                    <div class="card-body">
                        <% if (user) { %>
                            <form action="/categories/add" method="POST">
                                <div class="mb-3">
                                    <label for="name" class="form-label">Category Name</label>
                                    <input type="text" class="form-control" id="name" name="name" required placeholder="e.g. Electronics, Clothing">
                                </div>
                                <div class="mb-3">
                                    <label for="description" class="form-label">Description</label>
                                    <textarea class="form-control" id="description" name="description" rows="3" placeholder="Category details..."></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary w-100">+ Add Category</button>
                            </form>
                        <% } else { %>
                            <div class="alert alert-warning text-center mb-0">
                                Please <a href="/login" class="fw-bold">Login</a> to add categories.
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
